# Copie ce fichier en .env et remplis-le. Ne le partage JAMAIS et ne le mets pas sur GitHub
# (il est déjà ignoré par .gitignore).
#
# ⚠️ Le bot n'a besoin NI de ta seed phrase, NI de ta clé privée, NI de tes mots de passe.
#    Si quelqu'un (humain, bot ou IA) te les demande : c'est une arnaque.

# Telegram : crée un bot avec @BotFather, colle le token ici.
TELEGRAM_BOT_TOKEN=
# Laisse vide au début : lance le bot, envoie /start à ton bot Telegram, il te répond ton chat id.
TELEGRAM_CHAT_ID=

# X (Twitter) : « Bearer Token » de developer.x.com (lecture seule, API payante à l'usage).
X_BEARER_TOKEN=

# RPC Solana : le public marche mais est lent et limité. Une clé gratuite (Helius, QuickNode...)
# est fortement conseillée, ex : https://mainnet.helius-rpc.com/?api-key=TA_CLE
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# IA (optionnel) : clé API Anthropic (console.anthropic.com) pour analyser les posts.
ANTHROPIC_API_KEY=
