# Copie ce fichier en .env et remplis-le. Ne le partage JAMAIS et ne le mets pas sur GitHub
# (il est déjà ignoré par .gitignore).
#
# ⚠️ Le bot n'a besoin NI de ta seed phrase, NI de ta clé privée, NI de tes mots de passe.
#    Si quelqu'un (humain, bot ou IA) te les demande : c'est une arnaque.

# Telegram : crée un bot avec @BotFather, colle le token ici.
TELEGRAM_BOT_TOKEN=
# Laisse vide au début : lance le bot, envoie /start à ton bot Telegram, il te répond ton chat id.
TELEGRAM_CHAT_ID=

# X (Twitter) : « Bearer Token » de developer.x.com (lecture seule, API payante à l'usage).
X_BEARER_TOKEN=

# RPC Solana : le public marche mais est lent et limité. Une clé gratuite (Helius, QuickNode...)
# est fortement conseillée, ex : https://mainnet.helius-rpc.com/?api-key=TA_CLE
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Websocket RPC (optionnel) : par défaut déduit de SOLANA_RPC_URL (https -> wss).
# C'est par là que le bot lit les achats/ventes des tokens, gratuitement.
SOLANA_WS_URL=

# IA (optionnel) : clé API Anthropic (console.anthropic.com) pour analyser les posts.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------------------
# TRADING RÉEL (uniquement si mode = "live" dans la section [trading] de config.toml)
# Clé privée d'un wallet CRÉÉ EXPRÈS pour le bot, avec seulement ce que tu acceptes de perdre.
# JAMAIS ton wallet principal. JAMAIS à coller dans un chat, Discord, Telegram ou une IA.
# Formats acceptés : base58 (export Phantom) ou tableau JSON [12,34,...] (Solana CLI).
# Elle reste sur ta machine : le bot signe les transactions localement.
WALLET_PRIVATE_KEY=

# ---------------------------------------------------------------------------------------
# CHAÎNES TELEGRAM (gratuit) : lire des chaînes qui republient les tweets d'Elon, Trump...
# Clé gratuite : https://my.telegram.org → « API development tools » → crée une app.
# Puis, une seule fois : python -m memebot telegram-login
# ⚠️ Ces valeurs et le fichier telegram.session donnent accès à ton compte : ne les partage jamais.
TG_API_ID=
TG_API_HASH=

# ---------------------------------------------------------------------------------------
# PUMPPORTAL (optionnel, PAYANT) : depuis mai 2026, PumpPortal ne fournit les trades qu'avec
# une clé API liée à un wallet approvisionné. Laisse vide : le bot lit les trades
# gratuitement sur la blockchain via ta clé Helius.
PUMPPORTAL_API_KEY=
